# Shared
NODE_ENV=development
TZ=UTC

# API
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
# JWT bearer authentication used by the business portal. Automated tests set mock explicitly.
AUTH_MODE=production
JWT_ACCESS_SECRET=replace-with-a-random-32-character-minimum-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Placeholder business values pending real approval
RETURN_WINDOW_DAYS=7
DEFAULT_MARKETPLACE_COMMISSION_BPS=500
DEFAULT_PROMOTER_COMMISSION_BPS=0
SUPPORT_TICKET_DEFAULT_SLA_HOURS=48
# Kisan Club remains hidden and cannot affect checkout until explicitly enabled.
KISAN_CLUB_ENABLED=false
KISAN_CLUB_BENEFIT_TOKEN_TTL_HOURS=72
KISAN_CLUB_MAX_ACTIVE_FARMERS_PER_PROMOTER=150
DEFAULT_KISAN_CLUB_PROMOTER_COMMISSION_BPS=0
# Automated crop-protection advice is prohibited unless separately approved.
KISAN_CLUB_ADVISORY_CROP_PROTECTION_ENABLED=false

# Business web server-side API access
BUSINESS_WEB_API_BASE_URL=http://localhost:3001
BUSINESS_WEB_REFRESH_COOKIE_MAX_AGE_SECONDS=2592000

# Local services
DATABASE_URL=postgresql://vardhnam:vardhnam_dev_password@localhost:5432/vardhnam_agrotech?schema=public
# Integration tests must use a dedicated database; the reset helper rejects the development DB.
TEST_DATABASE_URL=postgresql://vardhnam:vardhnam_dev_password@localhost:5432/vardhnam_agrotech_test?schema=public
REDIS_URL=redis://localhost:6379

# Background jobs (WP-04). The API enqueues but never consumes: WORKER_MODE is
# forced on by `npm run start:worker` and must stay false for API processes.
# Leaving it false everywhere simply means jobs queue up until a worker starts.
WORKER_MODE=false
WORKER_CONCURRENCY=5
JOB_MAX_ATTEMPTS=5
# Namespaces queue keys so environments sharing one Redis cannot consume each
# other's jobs. Give staging and production distinct values.
QUEUE_PREFIX=vardhnam
SCHEDULER_TIMEZONE=Asia/Kolkata

# File and document storage (WP-08). Only `local` is implemented; the module
# throws on any other value rather than silently writing uploads to a container
# filesystem. A cloud provider is pending the hosting decision.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.storage
# Base URL clients reach this API on; signed storage URLs are built from it.
PUBLIC_API_BASE_URL=http://localhost:3001
STORAGE_UPLOAD_URL_TTL_SECONDS=900
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
# `mock` recognises the EICAR test string and passes everything else. It is NOT
# virus scanning -- a real scanner is required before any real upload.
VIRUS_SCANNER=mock

# Notification transports (WP-06). Only `mock` is implemented; the registry
# throws on any other value rather than silently failing to deliver, because a
# swallowed OTP leaves a user unable to log in with nothing in the logs to say
# why. A mock delivery is permanently identifiable by its MOCK- provider
# reference. PUSH additionally needs device-token registration (WP-10r).
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
EMAIL_PROVIDER=mock
PUSH_PROVIDER=mock
PAYMENT_PROVIDER=mock
TALLY_PROVIDER=mock

# API hardening (WP-16). The rate limit is a global ceiling applied to every
# route by a guard in AppModule; routes that need to be stricter (OTP request,
# payment confirmation, OTP-bearing delivery actions) declare their own much
# smaller limits in code and are unaffected by these values.
#
# NOTE: counting is per API process. Behind N replicas the effective ceiling is
# N x RATE_LIMIT_LIMIT, because the throttler store is in-memory. A shared store
# is required before scaling out beyond a single instance.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=300
# Uploads never pass through the API -- clients PUT bytes straight to object
# storage with a presigned URL -- so no legitimate request approaches this.
REQUEST_BODY_LIMIT_BYTES=524288
