artifacts/*.apk filter=lfs diff=lfs merge=lfs -text

# Generated and byte-compared: `openapi:check` regenerates this file and diffs it
# against the committed copy, so a CRLF checkout on Windows reports drift that
# does not exist. Pin it to LF on every platform.
apps/marketplace-api/openapi.json text eol=lf

# Gradle launchers must also work after cloning on Linux/macOS.
**/android/gradlew text eol=lf
**/android/gradlew.bat text eol=crlf
