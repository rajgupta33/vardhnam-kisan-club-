{
  "name": "@vardhnam/marketplace-api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API for the Vardhnam Agrotech marketplace.",
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/src/worker.js",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:integration": "npm run test:integration:mock-auth && npm run test:integration:production-auth",
    "test:integration:mock-auth": "node --env-file-if-exists=../../.env ../../node_modules/jest/bin/jest.js --config jest.integration.config.cjs",
    "test:integration:production-auth": "node --env-file-if-exists=../../.env ../../node_modules/jest/bin/jest.js --config jest.integration.auth.config.cjs",
    "openapi:generate": "npm run build && node --env-file-if-exists=../../.env dist/src/export-openapi.js",
    "openapi:check": "npm run build && node --env-file-if-exists=../../.env dist/src/export-openapi.js --check",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "seed": "node --env-file-if-exists=../../.env ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "seed:demo": "node --env-file-if-exists=../../.env ../../node_modules/tsx/dist/cli.mjs prisma/seed-demo.ts"
  },
  "dependencies": {
    "@ibm/plex-sans-devanagari": "^1.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.0",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.7.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.11.1",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.7.0"
  }
}
