generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  FARMER
  PROMOTER
  SALES_PARTNER
  DISTRIBUTOR_OWNER
  DISTRIBUTOR_STAFF
  COMPANY_OWNER
  COMPANY_STAFF
  SERVICE_PROVIDER
  DELIVERY_PARTNER
  SUPPORT_AGENT
  OPERATIONS_MANAGER
  FINANCE_MANAGER
  CATALOGUE_REVIEWER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OrganisationType {
  VARDHNAM
  COMPANY
  DISTRIBUTOR
  SERVICE_PROVIDER
  DELIVERY_PARTNER
}

enum OrganisationStatus {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum KycDocumentType {
  GST_CERTIFICATE
  PAN
  BUSINESS_REGISTRATION
  DISTRIBUTOR_AUTHORISATION
  BANK_PROOF
  ADDRESS_PROOF
  LICENCE
  OTHER
}

enum KycDocumentStatus {
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum CatalogueStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum ProductDocumentType {
  LABEL
  REGISTRATION_CERTIFICATE
  SAFETY_DATA_SHEET
  PRODUCT_IMAGE
  TEST_REPORT
  OTHER
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum InventoryBatchStatus {
  ACTIVE
  BLOCKED
  EXPIRED
}

enum InventoryMovementType {
  OPENING_STOCK
  STOCK_RECEIVED
  MANUAL_INCREASE
  MANUAL_DECREASE
  DAMAGE_WRITE_OFF
  RESERVED_FOR_ORDER
  RELEASED_FROM_ORDER
}

enum DistributorOfferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAUSED
  ARCHIVED
}

enum FulfilmentMode {
  DISTRIBUTOR_FULFILLED
  VARDHNAM_FULFILLED
  PICKUP
}

enum CartStatus {
  ACTIVE
  ABANDONED
}

enum OrderType {
  PRODUCT_ORDER
  SERVICE_ORDER
}

enum ProductCheckoutStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAYMENT_FAILED
  PAID
  CANCELLED
}

enum ProductOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAYMENT_FAILED
  CONFIRMED
  DISTRIBUTOR_ACCEPTED
  DISTRIBUTOR_REJECTED
  INVENTORY_RESERVED
  READY_TO_PACK
  PACKED
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  CANCELLATION_REQUESTED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  RETURN_IN_TRANSIT
  RETURNED
  REFUND_PENDING
  REFUNDED
  DISPUTED
  CLOSED
}

enum PaymentProviderMode {
  MOCK
}

enum PaymentIntentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PaymentEventType {
  INTENT_CREATED
  CONFIRMATION_STARTED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
}

enum ProductInvoiceStatus {
  GENERATED
  VOIDED
}

enum ProductDispatchStatus {
  READY_FOR_PICKUP
  CANCELLED
}

enum ProductDeliveryAssignmentStatus {
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  CANCELLED
}

model User {
  id                             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                          String?                     @unique
  phone                          String?                     @unique
  passwordHash                   String?
  status                         UserStatus                  @default(ACTIVE)
  profile                        UserProfile?
  farmerProfile                  FarmerProfile?
  memberships                    OrganisationMembership[]
  auditLogs                      AuditLog[]                  @relation("ActorAuditLogs")
  reviewedOrganisations          Organisation[]              @relation("OrganisationReviewedBy")
  reviewedBrands                 Brand[]                     @relation("BrandReviewedBy")
  reviewedProducts               MasterProduct[]             @relation("ProductReviewedBy")
  reviewedOffers                 DistributorOffer[]          @relation("OfferReviewedBy")
  inventoryMovements             InventoryMovement[]         @relation("InventoryMovementCreatedBy")
  productOrderHistory            ProductOrderStatusHistory[] @relation("ProductOrderStatusChangedBy")
  paymentEvents                  PaymentEvent[]              @relation("PaymentEventActor")
  generatedProductInvoices       ProductInvoice[]            @relation("ProductInvoiceGeneratedBy")
  readyProductDispatches         ProductDispatch[]           @relation("ProductDispatchReadyBy")
  deliveryAssignments            ProductDeliveryAssignment[] @relation("ProductDeliveryPartner")
  assignedProductDeliveries      ProductDeliveryAssignment[] @relation("ProductDeliveryAssignedBy")
  startedProductDeliveries       ProductDeliveryAssignment[] @relation("ProductDeliveryStartedBy")
  completedProductDeliveries     ProductDeliveryAssignment[] @relation("ProductDeliveryCompletedBy")
  refreshTokens                  RefreshToken[]
  createdCommissionRules         CommissionRule[]            @relation("CommissionRuleCreatedBy")
  createdSettlements             Settlement[]                @relation("SettlementCreatedBy")
  promoterAttributionsAsPromoter PromoterAttribution[]       @relation("PromoterAttributionPromoter")
  createdPromoterAttributions    PromoterAttribution[]       @relation("PromoterAttributionCreatedBy")
  commissionEntriesAsRecipient   CommissionEntry[]           @relation("CommissionEntryRecipient")
  payoutAccount                  PayoutAccount?
  verifiedPayoutAccounts         PayoutAccount[]             @relation("PayoutAccountVerifiedBy")
  raisedSupportTickets           SupportTicket[]             @relation("SupportTicketRaisedBy")
  assignedSupportTickets         SupportTicket[]             @relation("SupportTicketAssignedTo")
  uploadedSupportTicketEvidence  SupportTicketEvidence[]     @relation("SupportTicketEvidenceUploadedBy")
  enqueuedTallySyncRecords       TallySyncRecord[]           @relation("TallySyncRecordEnqueuedBy")
  performedTallySyncAttempts     TallySyncAttempt[]          @relation("TallySyncAttemptPerformedBy")
  receivedNotifications          Notification[]              @relation("NotificationRecipient")
  triggeredNotifications         Notification[]              @relation("NotificationTriggeredBy")
  performedNotificationAttempts  NotificationAttempt[]        @relation("NotificationAttemptPerformedBy")
  createdAt                      DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                    @updatedAt @db.Timestamptz(6)

  @@index([status])
}

enum OtpPurpose {
  LOGIN
}

model OtpChallenge {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone        String
  purpose      OtpPurpose @default(LOGIN)
  otpHash      String
  otpSalt      String
  expiresAt    DateTime   @db.Timestamptz(6)
  attemptCount Int        @default(0)
  consumedAt   DateTime?  @db.Timestamptz(6)
  requestedIp  String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  @@index([phone, purpose, consumedAt])
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId      String    @db.Uuid
  tokenHash         String    @unique
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId, revokedAt])
}

model UserProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  preferredLocale String   @default("en-IN")
  timezone        String   @default("Asia/Kolkata")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
}

model FarmerProfile {
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                     String                      @unique @db.Uuid
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                   String
  alternatePhone             String?
  preferredLocale            String                      @default("en-IN")
  village                    String?
  district                   String?
  state                      String?
  primaryPincode             String?
  cropInterests              String[]                    @default([])
  addresses                  FarmerAddress[]
  cart                       Cart?
  productCheckouts           ProductCheckout[]
  productOrders              ProductOrder[]
  productInvoices            ProductInvoice[]
  productDispatches          ProductDispatch[]
  productDeliveryAssignments ProductDeliveryAssignment[]
  paymentIntents             PaymentIntent[]
  promoterAttributions       PromoterAttribution[]
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(6)

  @@index([state, district])
  @@index([primaryPincode])
}

model FarmerAddress {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmerProfileId        String            @db.Uuid
  farmerProfile          FarmerProfile     @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  label                  String
  recipientName          String
  phone                  String
  addressLine1           String
  addressLine2           String?
  village                String?
  city                   String
  district               String?
  state                  String
  pincode                String
  landmark               String?
  isDefault              Boolean           @default(false)
  deliveryCarts          Cart[]            @relation("CartDeliveryAddress")
  checkoutDeliveries     ProductCheckout[] @relation("CheckoutDeliveryAddress")
  productOrderDeliveries ProductOrder[]    @relation("ProductOrderDeliveryAddress")
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)

  @@index([farmerProfileId, isDefault])
  @@index([pincode])
}

model Organisation {
  id                               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                             OrganisationType
  slug                             String                      @unique
  legalName                        String
  displayName                      String
  gstin                            String?
  status                           OrganisationStatus          @default(PENDING_VERIFICATION)
  reviewedAt                       DateTime?                   @db.Timestamptz(6)
  reviewedByUserId                 String?                     @db.Uuid
  reviewedBy                       User?                       @relation("OrganisationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewReason                     String?
  memberships                      OrganisationMembership[]
  companyProfile                   CompanyProfile?
  distributorProfile               DistributorProfile?
  kycDocuments                     KycDocument[]
  brands                           Brand[]                     @relation("CompanyBrands")
  masterProducts                   MasterProduct[]             @relation("CompanyProducts")
  warehouses                       Warehouse[]                 @relation("DistributorWarehouses")
  inventoryBatches                 InventoryBatch[]            @relation("DistributorBatches")
  inventoryMovements               InventoryMovement[]         @relation("DistributorInventoryMovements")
  distributorOffers                DistributorOffer[]          @relation("DistributorOffers")
  cartItems                        CartItem[]
  sellerProductOrders              ProductOrder[]              @relation("SellerProductOrders")
  sellerProductInvoices            ProductInvoice[]            @relation("SellerProductInvoices")
  sellerProductDispatches          ProductDispatch[]           @relation("SellerProductDispatches")
  sellerProductDeliveryAssignments ProductDeliveryAssignment[] @relation("SellerProductDeliveryAssignments")
  auditLogs                        AuditLog[]
  sellerCommissionRules            CommissionRule[]            @relation("SellerCommissionRules")
  sellerCommissionEntries          CommissionEntry[]           @relation("SellerCommissionEntries")
  financialLedgerEntries           FinancialLedgerEntry[]      @relation("OrganisationFinancialLedgerEntries")
  sellerSettlements                Settlement[]                @relation("SellerSettlements")
  promoterAttributions             PromoterAttribution[]       @relation("PromoterAttributionOrganisation")
  supportTickets                   SupportTicket[]
  createdAt                        DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                        DateTime                    @updatedAt @db.Timestamptz(6)
  productOrderItems                ProductOrderItem[]

  @@index([type, status])
  @@index([reviewedByUserId, reviewedAt])
}

model CompanyProfile {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String       @unique @db.Uuid
  organisation        Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  brandName           String?
  registrationNumber  String?
  pan                 String?
  primaryContactName  String
  primaryContactPhone String
  primaryContactEmail String?
  website             String?
  registeredAddress   String?
  city                String?
  state               String?
  pincode             String?
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)

  @@index([brandName])
  @@index([state, city])
}

model DistributorProfile {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId       String       @unique @db.Uuid
  organisation         Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  distributorCode      String?      @unique
  pan                  String?
  primaryContactName   String
  primaryContactPhone  String
  primaryContactEmail  String?
  operatingAddress     String?
  city                 String?
  state                String?
  pincode              String?
  serviceablePincodes  String[]     @default([])
  fulfilmentCapability String?
  createdAt            DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(6)

  @@index([state, city])
}

model KycDocument {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String            @db.Uuid
  organisation    Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  documentType    KycDocumentType
  status          KycDocumentStatus @default(SUBMITTED)
  documentNumber  String?
  fileName        String?
  storageKey      String?
  issuedAt        DateTime?         @db.Timestamptz(6)
  expiresAt       DateTime?         @db.Timestamptz(6)
  rejectionReason String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  @@index([organisationId, status])
  @@index([documentType, status])
}

model Brand {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyOrganisationId String          @db.Uuid
  companyOrganisation   Organisation    @relation("CompanyBrands", fields: [companyOrganisationId], references: [id], onDelete: Restrict)
  name                  String
  slug                  String
  description           String?
  website               String?
  status                CatalogueStatus @default(DRAFT)
  reviewedAt            DateTime?       @db.Timestamptz(6)
  reviewedByUserId      String?         @db.Uuid
  reviewedBy            User?           @relation("BrandReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewReason          String?
  products              MasterProduct[]
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(6)

  @@unique([companyOrganisationId, slug])
  @@index([companyOrganisationId, status])
  @@index([status, createdAt])
}

model MasterProduct {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyOrganisationId String              @db.Uuid
  companyOrganisation   Organisation        @relation("CompanyProducts", fields: [companyOrganisationId], references: [id], onDelete: Restrict)
  brandId               String              @db.Uuid
  brand                 Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name                  String
  slug                  String
  category              String
  description           String?
  cropTargets           String[]            @default([])
  status                CatalogueStatus     @default(DRAFT)
  reviewedAt            DateTime?           @db.Timestamptz(6)
  reviewedByUserId      String?             @db.Uuid
  reviewedBy            User?               @relation("ProductReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewReason          String?
  variants              ProductVariant[]
  documents             ProductDocument[]
  inventoryBatches      InventoryBatch[]
  inventoryMovements    InventoryMovement[]
  distributorOffers     DistributorOffer[]
  cartItems             CartItem[]
  productOrderItems     ProductOrderItem[]
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(6)

  @@unique([companyOrganisationId, slug])
  @@index([brandId, status])
  @@index([companyOrganisationId, status])
  @@index([status, createdAt])
}

model ProductVariant {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String              @db.Uuid
  product            MasterProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku                String?
  variantName        String
  packSize           Decimal             @db.Decimal(12, 3)
  packUnit           String
  mrpPaise           Int?
  isActive           Boolean             @default(true)
  inventoryBatches   InventoryBatch[]
  inventoryMovements InventoryMovement[]
  distributorOffers  DistributorOffer[]
  cartItems          CartItem[]
  productOrderItems  ProductOrderItem[]
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)

  @@unique([productId, sku])
  @@index([productId, isActive])
}

model ProductDocument {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String              @db.Uuid
  product        MasterProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)
  documentType   ProductDocumentType
  title          String
  documentNumber String?
  fileName       String?
  storageKey     String?
  issuedAt       DateTime?           @db.Timestamptz(6)
  expiresAt      DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  @@index([productId, documentType])
}

model Warehouse {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  distributorOrganisationId String              @db.Uuid
  distributorOrganisation   Organisation        @relation("DistributorWarehouses", fields: [distributorOrganisationId], references: [id], onDelete: Restrict)
  code                      String
  name                      String
  addressLine1              String
  addressLine2              String?
  city                      String
  state                     String
  pincode                   String
  contactName               String?
  contactPhone              String?
  status                    WarehouseStatus     @default(ACTIVE)
  batches                   InventoryBatch[]
  inventoryMovements        InventoryMovement[]
  distributorOffers         DistributorOffer[]
  cartItems                 CartItem[]
  productOrderItems         ProductOrderItem[]
  createdAt                 DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime            @updatedAt @db.Timestamptz(6)

  @@unique([distributorOrganisationId, code])
  @@index([distributorOrganisationId, status])
  @@index([state, city])
}

model InventoryBatch {
  id                           String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  distributorOrganisationId    String                        @db.Uuid
  distributorOrganisation      Organisation                  @relation("DistributorBatches", fields: [distributorOrganisationId], references: [id], onDelete: Restrict)
  warehouseId                  String                        @db.Uuid
  warehouse                    Warehouse                     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId                    String                        @db.Uuid
  product                      MasterProduct                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId                    String                        @db.Uuid
  variant                      ProductVariant                @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batchNumber                  String
  manufacturingDate            DateTime?                     @db.Date
  expiryDate                   DateTime?                     @db.Date
  germinationPercentage        Decimal?                      @db.Decimal(5, 2)
  status                       InventoryBatchStatus          @default(ACTIVE)
  blockedReason                String?
  inventoryMovements           InventoryMovement[]
  distributorOffers            DistributorOffer[]
  cartItems                    CartItem[]
  productOrderItemReservations ProductOrderItemReservation[]
  createdAt                    DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                      @updatedAt @db.Timestamptz(6)

  @@unique([warehouseId, variantId, batchNumber])
  @@index([distributorOrganisationId, status])
  @@index([warehouseId, status])
  @@index([productId, variantId])
  @@index([expiryDate, status])
}

model InventoryMovement {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  distributorOrganisationId   String                       @db.Uuid
  distributorOrganisation     Organisation                 @relation("DistributorInventoryMovements", fields: [distributorOrganisationId], references: [id], onDelete: Restrict)
  warehouseId                 String                       @db.Uuid
  warehouse                   Warehouse                    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batchId                     String                       @db.Uuid
  batch                       InventoryBatch               @relation(fields: [batchId], references: [id], onDelete: Restrict)
  productId                   String                       @db.Uuid
  product                     MasterProduct                @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId                   String                       @db.Uuid
  variant                     ProductVariant               @relation(fields: [variantId], references: [id], onDelete: Restrict)
  movementType                InventoryMovementType
  quantityDelta               Int
  balanceAfter                Int
  reason                      String
  referenceType               String?
  referenceId                 String?
  createdByUserId             String?                      @db.Uuid
  createdBy                   User?                        @relation("InventoryMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  productOrderItemReservation ProductOrderItemReservation?
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(6)

  @@index([batchId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([distributorOrganisationId, createdAt])
  @@index([productId, variantId])
  @@index([movementType, createdAt])
}

model DistributorOffer {
  id                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  distributorOrganisationId String                 @db.Uuid
  distributorOrganisation   Organisation           @relation("DistributorOffers", fields: [distributorOrganisationId], references: [id], onDelete: Restrict)
  productId                 String                 @db.Uuid
  product                   MasterProduct          @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId                 String                 @db.Uuid
  variant                   ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouseId               String                 @db.Uuid
  warehouse                 Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batchId                   String?                @db.Uuid
  batch                     InventoryBatch?        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  offerCode                 String?
  sellingPricePaise         Int
  minimumOrderQuantity      Int                    @default(1)
  maximumOrderQuantity      Int?
  serviceablePincodes       String[]               @default([])
  fulfilmentMode            FulfilmentMode
  deliverySlaDays           Int?
  status                    DistributorOfferStatus @default(DRAFT)
  reviewedAt                DateTime?              @db.Timestamptz(6)
  reviewedByUserId          String?                @db.Uuid
  reviewedBy                User?                  @relation("OfferReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewReason              String?
  cartItems                 CartItem[]
  productOrderItems         ProductOrderItem[]
  createdAt                 DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime               @updatedAt @db.Timestamptz(6)

  @@unique([distributorOrganisationId, offerCode])
  @@index([distributorOrganisationId, status])
  @@index([productId, variantId])
  @@index([warehouseId, status])
  @@index([batchId])
  @@index([status, createdAt])
}

model Cart {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmerProfileId    String            @unique @db.Uuid
  farmerProfile      FarmerProfile     @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  deliveryAddressId  String?           @db.Uuid
  deliveryAddress    FarmerAddress?    @relation("CartDeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  serviceablePincode String?
  status             CartStatus        @default(ACTIVE)
  items              CartItem[]
  productCheckouts   ProductCheckout[] @relation("CheckoutSourceCart")
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  @@index([farmerProfileId, status])
  @@index([serviceablePincode])
}

model CartItem {
  id                         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId                     String           @db.Uuid
  cart                       Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offerId                    String           @db.Uuid
  offer                      DistributorOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  distributorOrganisationId  String           @db.Uuid
  distributorOrganisation    Organisation     @relation(fields: [distributorOrganisationId], references: [id], onDelete: Restrict)
  productId                  String           @db.Uuid
