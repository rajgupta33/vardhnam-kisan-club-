  createdBy                User?                @relation("CommissionRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByRole            PlatformRole?
  reason                   String?
  createdAt                DateTime             @default(now()) @db.Timestamptz(6)

  commissionEntries CommissionEntry[]

  @@index([sellerOrganisationId, status, effectiveFrom])
  @@index([status, effectiveFrom])
}

enum CommissionEntryType {
  MARKETPLACE_COMMISSION
  DISTRIBUTOR_PAYABLE
  PROMOTER_COMMISSION
  DELIVERY_FEE
}

enum CommissionEntryStatus {
  PROVISIONAL
  FINAL
  REVERSED
}

model CommissionEntry {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productOrderId       String                 @db.Uuid
  productOrder         ProductOrder           @relation(fields: [productOrderId], references: [id], onDelete: Restrict)
  sellerOrganisationId String                 @db.Uuid
  sellerOrganisation   Organisation           @relation("SellerCommissionEntries", fields: [sellerOrganisationId], references: [id], onDelete: Restrict)
  commissionRuleId     String                 @db.Uuid
  commissionRule       CommissionRule         @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)
  entryType            CommissionEntryType
  amountPaise          Int
  status               CommissionEntryStatus  @default(PROVISIONAL)
  eligibleAt           DateTime               @db.Timestamptz(6)
  finalizedAt          DateTime?              @db.Timestamptz(6)
  reversedAt           DateTime?              @db.Timestamptz(6)
  reversalReason       String?
  settlementId         String?                @db.Uuid
  settlement           Settlement?            @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  recipientUserId      String?                @db.Uuid
  recipient            User?                  @relation("CommissionEntryRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  ledgerEntries        FinancialLedgerEntry[]
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)

  @@index([productOrderId, entryType])
  @@index([sellerOrganisationId, entryType, status])
  @@index([status, eligibleAt])
  @@index([settlementId])
  @@index([recipientUserId, status])
}

enum FinancialLedgerEntryType {
  FARMER_PAYMENT
  CLUB_BENEFIT_SUBSIDY
  MARKETPLACE_COMMISSION
  DISTRIBUTOR_PAYABLE
  PROMOTER_COMMISSION
  DELIVERY_FEE
  REFUND
  SETTLEMENT
  ADJUSTMENT
}

model FinancialLedgerEntry {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryType         FinancialLedgerEntryType
  amountPaise       Int
  organisationId    String?                  @db.Uuid
  organisation      Organisation?            @relation("OrganisationFinancialLedgerEntries", fields: [organisationId], references: [id], onDelete: SetNull)
  productOrderId    String?                  @db.Uuid
  productOrder      ProductOrder?            @relation(fields: [productOrderId], references: [id], onDelete: SetNull)
  paymentIntentId   String?                  @db.Uuid
  paymentIntent     PaymentIntent?           @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  commissionEntryId String?                  @db.Uuid
  commissionEntry   CommissionEntry?         @relation(fields: [commissionEntryId], references: [id], onDelete: SetNull)
  settlementId      String?                  @db.Uuid
  settlement        Settlement?              @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  refundId          String?                  @db.Uuid
  refund            Refund?                  @relation(fields: [refundId], references: [id], onDelete: SetNull)
  disputeId         String?                  @db.Uuid
  dispute           Dispute?                 @relation(fields: [disputeId], references: [id], onDelete: SetNull)
