  verifiedAt        DateTime?           @db.Timestamptz(6)
  verifiedByUserId  String?             @db.Uuid
  verifiedBy        User?               @relation("PayoutAccountVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedByRole    PlatformRole?
  rejectionReason   String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(6)

  @@index([status])
}

enum SupportTicketStatus {
  OPEN
  ASSIGNED
  WAITING_FOR_CUSTOMER
  WAITING_FOR_SELLER
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
}

enum SupportTicketCategory {
  ORDER_ISSUE
  PAYMENT_ISSUE
  DELIVERY_ISSUE
  PRODUCT_QUALITY
  ACCOUNT_ISSUE
  ONBOARDING_ISSUE
  OTHER
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  raisedByUserId       String                  @db.Uuid
  raisedBy             User                    @relation("SupportTicketRaisedBy", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  raisedByRole         PlatformRole
  raiserOrganisationId String?                 @db.Uuid
  raiserOrganisation   Organisation?           @relation(fields: [raiserOrganisationId], references: [id], onDelete: SetNull)
  productOrderId       String?                 @db.Uuid
  productOrder         ProductOrder?           @relation(fields: [productOrderId], references: [id], onDelete: SetNull)
  category             SupportTicketCategory
  priority             SupportTicketPriority   @default(MEDIUM)
  subject              String
  description          String
  status               SupportTicketStatus     @default(OPEN)
  assignedToUserId     String?                 @db.Uuid
  assignedTo           User?                   @relation("SupportTicketAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedAt           DateTime?               @db.Timestamptz(6)
  slaDueAt             DateTime                @db.Timestamptz(6)
  resolutionNote       String?
  resolvedAt           DateTime?               @db.Timestamptz(6)
  closedAt             DateTime?               @db.Timestamptz(6)
  evidence             SupportTicketEvidence[]
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(6)

  @@index([raisedByUserId, status])
  @@index([assignedToUserId, status])
  @@index([status, priority])
  @@index([productOrderId])
}

model SupportTicketEvidence {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supportTicketId  String        @db.Uuid
  supportTicket    SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  fileName         String
  storageKey       String
  uploadedByUserId String        @db.Uuid
  uploadedBy       User          @relation("SupportTicketEvidenceUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  uploadedByRole   PlatformRole
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)

  @@index([supportTicketId])
}

enum TallySyncRecordType {
  PARTY_MASTER
  ITEM_MASTER
  VOUCHER
  INVOICE
  CREDIT_NOTE
  RECEIPT
  SETTLEMENT
  COMMISSION_INVOICE
}

enum TallySyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

model TallySyncRecord {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordType              TallySyncRecordType
  sourceEntityId          String?             @db.Uuid
  referenceLabelSnapshot  String
  referenceNumberSnapshot String?
  amountPaise             Int?
  payloadSnapshot         Json
  status                  TallySyncStatus     @default(PENDING)
  attemptCount            Int                 @default(0)
  lastAttemptAt           DateTime?           @db.Timestamptz(6)
  lastErrorCode           String?
  lastErrorMessage        String?
  tallyReferenceId        String?
  enqueuedByUserId        String?             @db.Uuid
  enqueuedBy              User?               @relation("TallySyncRecordEnqueuedBy", fields: [enqueuedByUserId], references: [id], onDelete: SetNull)
  enqueuedByRole          PlatformRole?
  reason                  String?
  attempts                TallySyncAttempt[]
  createdAt               DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(6)

  @@index([recordType, status])
  @@index([status, createdAt])
  @@index([sourceEntityId])
}

model TallySyncAttempt {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tallySyncRecordId String          @db.Uuid
  tallySyncRecord   TallySyncRecord @relation(fields: [tallySyncRecordId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  outcome           TallySyncStatus
  errorCode         String?
  errorMessage      String?
  performedByUserId String?         @db.Uuid
  performedBy       User?           @relation("TallySyncAttemptPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)
  performedByRole   PlatformRole?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)

  @@index([tallySyncRecordId])
}

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId       String                @db.Uuid
  recipient             User                  @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  channel               NotificationChannel
  category              String
  title                 String
  body                  String
  payloadSnapshot       Json?
  status                NotificationStatus    @default(PENDING)
  attemptCount          Int                   @default(0)
  lastAttemptAt         DateTime?             @db.Timestamptz(6)
  lastErrorCode         String?
  lastErrorMessage      String?
  providerReferenceId   String?
  readAt                DateTime?             @db.Timestamptz(6)
  relatedResourceType   String?
  relatedResourceId     String?               @db.Uuid
  triggeredByUserId     String?               @db.Uuid
  triggeredBy           User?                 @relation("NotificationTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  triggeredByRole       PlatformRole?
  reason                String?
  attempts              NotificationAttempt[]
  createdAt             DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(6)

  @@index([recipientUserId, status])
  @@index([recipientUserId, readAt])
  @@index([channel, status])
}

model NotificationAttempt {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String              @db.Uuid
  notification      Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  outcome           NotificationStatus
  errorCode         String?
  errorMessage      String?
  performedByUserId String?             @db.Uuid
  performedBy       User?               @relation("NotificationAttemptPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)
  performedByRole   PlatformRole?
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)

  @@index([notificationId])
}
