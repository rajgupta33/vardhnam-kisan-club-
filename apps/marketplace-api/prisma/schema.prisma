model TallySyncAttempt {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tallySyncRecordId String          @db.Uuid
  tallySyncRecord   TallySyncRecord @relation(fields: [tallySyncRecordId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  outcome           TallySyncStatus
  errorCode         String?
  errorMessage      String?
  performedByUserId String?         @db.Uuid
  performedBy       User?           @relation("TallySyncAttemptPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)
  performedByRole   PlatformRole?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)

  @@index([tallySyncRecordId])
}

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId     String                @db.Uuid
  recipient           User                  @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  channel             NotificationChannel
  category            String
  title               String
  body                String
  payloadSnapshot     Json?
  status              NotificationStatus    @default(PENDING)
  attemptCount        Int                   @default(0)
  lastAttemptAt       DateTime?             @db.Timestamptz(6)
  lastErrorCode       String?
  lastErrorMessage    String?
  providerReferenceId String?
  readAt              DateTime?             @db.Timestamptz(6)
  relatedResourceType String?
  relatedResourceId   String?               @db.Uuid
  triggeredByUserId   String?               @db.Uuid
  triggeredBy         User?                 @relation("NotificationTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  triggeredByRole     PlatformRole?
  reason              String?
  attempts            NotificationAttempt[]
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)

  @@index([recipientUserId, status])
  @@index([recipientUserId, readAt])
  @@index([channel, status])
}

model NotificationAttempt {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String             @db.Uuid
  notification      Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  outcome           NotificationStatus
  errorCode         String?
  errorMessage      String?
  performedByUserId String?            @db.Uuid
  performedBy       User?              @relation("NotificationAttemptPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)
  performedByRole   PlatformRole?
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)

  @@index([notificationId])
}

enum StoredFilePurpose {
  KYC_DOCUMENT
  PRODUCT_IMAGE
  PRODUCT_DOCUMENT
  DELIVERY_PROOF
  RETURN_EVIDENCE
  SUPPORT_EVIDENCE
  VISIT_EVIDENCE
  INVOICE_PDF
  CREDIT_NOTE_PDF
  SERVICE_EVIDENCE
}

enum StoredFileStatus {
  PENDING_UPLOAD
  PENDING_SCAN
  AVAILABLE
  INFECTED
  REJECTED
  DELETED
}

enum StoredFileScanResult {
  CLEAN
  INFECTED
  SCAN_FAILED
}

/// Every file the platform holds. Bytes live in object storage; this row is the
/// authoritative record of what the object is, who owns it and whether it may be
/// downloaded. A file is only readable once scanning has cleared it.
model StoredFile {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId          String                  @db.Uuid
  ownerUser            User                    @relation("StoredFileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  organisationId       String?                 @db.Uuid
  organisation         Organisation?           @relation("StoredFileOrganisation", fields: [organisationId], references: [id], onDelete: Restrict)
  purpose              StoredFilePurpose
  status               StoredFileStatus        @default(PENDING_UPLOAD)
  objectKey            String                  @unique
  originalFilename     String
  contentType          String
  /// Size the client promised when requesting the upload URL. Kept alongside the
  /// observed size so a client that lies can be detected on confirm.
  declaredSizeBytes    Int
  sizeBytes            Int?
  checksumSha256       String?
  scanResult           StoredFileScanResult?
  scanCompletedAt      DateTime?               @db.Timestamptz(6)
  rejectionReason      String?
  uploadedAt           DateTime?               @db.Timestamptz(6)
  uploadUrlExpiresAt   DateTime                @db.Timestamptz(6)
  kycDocuments         KycDocument[]           @relation("KycDocumentStoredFile")
  supportEvidence      SupportTicketEvidence[] @relation("SupportEvidenceStoredFile")
  returnEvidence       ReturnRequestEvidence[] @relation("ReturnEvidenceStoredFile")
  productPrimaryImages MasterProduct[]         @relation("ProductPrimaryImage")
  invoiceDocument      ProductInvoiceDocument?
  creditNoteDocument   CreditNoteDocument?
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(6)

  @@index([ownerUserId, purpose])
  @@index([organisationId, purpose])
  @@index([status, createdAt])
}

/// Whether a recipient wants a given category on a given channel.
///
/// Absence means "use the default for that category". Only categories the
/// platform classes as non-transactional can be disabled; the service rejects an
/// attempt to switch off an order, payment, refund or security message, because
/// those are the record of a transaction the recipient is party to rather than
/// marketing.
model NotificationPreference {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)
  category  String
  channel   NotificationChannel
  enabled   Boolean
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)

  @@unique([userId, category, channel])
  @@index([userId])
}
