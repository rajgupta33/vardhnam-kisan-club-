/// Which side of the payment provider the platform is talking to.
///
/// `MOCK` is the in-process provider used by development and CI: it never
/// touches the network, but it signs and verifies webhooks with the same
/// HMAC-SHA256 scheme the Indian gateways use, so the verification, dedupe and
/// async-processing paths are genuinely exercised. `SANDBOX` and `LIVE` are the
/// two faces of a real merchant account and are selected by `PAYMENT_PROVIDER`.
enum PaymentProviderMode {
  MOCK
  SANDBOX
  LIVE
}

enum PaymentIntentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PaymentEventType {
  INTENT_CREATED
  CONFIRMATION_STARTED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  /// A signature-verified webhook was accepted for this intent. Recorded on
  /// receipt, before processing, so a webhook that later fails to apply is
  /// still visible on the intent's timeline.
  WEBHOOK_RECEIVED
  /// The provider's own view of the intent was fetched directly, either by
  /// reconciliation or by an operator.
  STATUS_FETCHED
  /// Reconciliation found the provider and the platform disagreeing about this
  /// intent. Never resolved silently -- it is a finance decision.
  RECONCILIATION_MISMATCH
}

/// How far a received webhook has got through processing.
///
/// `RECEIVED` is written inside the request, before the 200; everything after
/// happens on the `payment-webhooks` queue. `IGNORED` is a success, not a
/// failure: it is what a redelivery of an already-applied event becomes.
enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

