  promoterUserId         String                       @db.Uuid
  promoterUser           User                         @relation("PromoterAttributionPromoter", fields: [promoterUserId], references: [id], onDelete: Restrict)
  promoterOrganisationId String                       @db.Uuid
  promoterOrganisation   Organisation                 @relation("PromoterAttributionOrganisation", fields: [promoterOrganisationId], references: [id], onDelete: Restrict)
  farmerProfileId        String                       @db.Uuid
  farmerProfile          FarmerProfile                @relation(fields: [farmerProfileId], references: [id], onDelete: Restrict)
