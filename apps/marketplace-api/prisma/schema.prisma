/// Every webhook the platform has accepted from a payment provider, stored raw.
///
/// The row is written inside the HTTP request, immediately after signature
/// verification and before any interpretation, so that a payload we could not
/// parse is still evidence rather than a lost delivery. Providers redeliver
/// freely, so `(provider, providerEventId)` is unique and a duplicate is
/// resolved by the insert failing rather than by a read-then-write race.
///
/// `payloadDigest` is a SHA-256 of the raw body. A redelivery whose digest
/// differs from the one already stored for that event id means the provider
/// changed its mind about an event it had already sent, which is worth an
/// operator's attention rather than a silent overwrite.
model WebhookEvent {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String
  providerEventId String
  eventType       String
  /// Verbatim request body. Kept as text, not parsed JSON: signature
  /// verification is byte-exact, and a re-serialised payload could not be
  /// re-verified later during a dispute.
  rawPayload      String
  payloadDigest   String
  signature       String
  paymentIntentId String?                 @db.Uuid
  paymentIntent   PaymentIntent?          @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  status          WebhookProcessingStatus @default(RECEIVED)
  attemptCount    Int                     @default(0)
  failureReason   String?
  requestId       String?
  receivedAt      DateTime                @default(now()) @db.Timestamptz(6)
  processedAt     DateTime?               @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([paymentIntentId, receivedAt])
}

