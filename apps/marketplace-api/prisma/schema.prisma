  @@index([entryType, createdAt])
  @@index([organisationId, createdAt])
  @@index([productOrderId])
  @@index([paymentIntentId])
  @@index([commissionEntryId])
  @@index([settlementId])
  @@index([refundId])
  @@index([disputeId])
}

enum SettlementStatus {
  ELIGIBLE
}

model Settlement {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerOrganisationId String           @db.Uuid
  sellerOrganisation   Organisation     @relation("SellerSettlements", fields: [sellerOrganisationId], references: [id], onDelete: Restrict)
  settlementNumber     String           @unique
  totalPayablePaise    Int
  entryCount           Int
  status               SettlementStatus @default(ELIGIBLE)
  createdByUserId      String?          @db.Uuid
  createdBy            User?            @relation("SettlementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByRole        PlatformRole?
  createdAt            DateTime         @default(now()) @db.Timestamptz(6)

  commissionEntries CommissionEntry[]
  ledgerEntries     FinancialLedgerEntry[]

  @@index([sellerOrganisationId, status])
}

enum PromoterAttributionStatus {
  ACTIVE
  REVOKED
}

model PromoterAttribution {
