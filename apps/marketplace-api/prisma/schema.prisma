model User {
  id                             String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                          String?                            @unique
  phone                          String?                            @unique
  passwordHash                   String?
  status                         UserStatus                         @default(ACTIVE)
  profile                        UserProfile?
  farmerProfile                  FarmerProfile?
  memberships                    OrganisationMembership[]
  auditLogs                      AuditLog[]                         @relation("ActorAuditLogs")
  reviewedOrganisations          Organisation[]                     @relation("OrganisationReviewedBy")
  reviewedBrands                 Brand[]                            @relation("BrandReviewedBy")
  reviewedProducts               MasterProduct[]                    @relation("ProductReviewedBy")
  reviewedOffers                 DistributorOffer[]                 @relation("OfferReviewedBy")
  inventoryMovements             InventoryMovement[]                @relation("InventoryMovementCreatedBy")
  productOrderHistory            ProductOrderStatusHistory[]        @relation("ProductOrderStatusChangedBy")
  paymentEvents                  PaymentEvent[]                     @relation("PaymentEventActor")
  generatedProductInvoices       ProductInvoice[]                   @relation("ProductInvoiceGeneratedBy")
  readyProductDispatches         ProductDispatch[]                  @relation("ProductDispatchReadyBy")
  issuedProductDispatchLabels    ProductDispatch[]                  @relation("ProductDispatchQrIssuedBy")
  deliveryAssignments            ProductDeliveryAssignment[]        @relation("ProductDeliveryPartner")
  deliveryPartnerProfiles        DeliveryPartnerProfile[]           @relation("DeliveryPartnerProfileUser")
  farmerLeads                    FarmerLead[]                       @relation("FarmerLeadPromoter")
  promoterVisits                 PromoterVisit[]                    @relation("PromoterVisitPromoter")
  assignedProductDeliveries      ProductDeliveryAssignment[]        @relation("ProductDeliveryAssignedBy")
  startedProductDeliveries       ProductDeliveryAssignment[]        @relation("ProductDeliveryStartedBy")
  pickupVerifiedDeliveries       ProductDeliveryAssignment[]        @relation("ProductDeliveryPickupVerifiedBy")
  completedProductDeliveries     ProductDeliveryAssignment[]        @relation("ProductDeliveryCompletedBy")
  failedProductDeliveries        ProductDeliveryAssignment[]        @relation("ProductDeliveryFailedBy")
  refreshTokens                  RefreshToken[]
  createdCommissionRules         CommissionRule[]                   @relation("CommissionRuleCreatedBy")
  createdSettlements             Settlement[]                       @relation("SettlementCreatedBy")
  promoterAttributionsAsPromoter PromoterAttribution[]              @relation("PromoterAttributionPromoter")
  createdPromoterAttributions    PromoterAttribution[]              @relation("PromoterAttributionCreatedBy")
  commissionEntriesAsRecipient   CommissionEntry[]                  @relation("CommissionEntryRecipient")
  payoutAccount                  PayoutAccount?
  verifiedPayoutAccounts         PayoutAccount[]                    @relation("PayoutAccountVerifiedBy")
  raisedSupportTickets           SupportTicket[]                    @relation("SupportTicketRaisedBy")
  assignedSupportTickets         SupportTicket[]                    @relation("SupportTicketAssignedTo")
  uploadedSupportTicketEvidence  SupportTicketEvidence[]            @relation("SupportTicketEvidenceUploadedBy")
  enqueuedTallySyncRecords       TallySyncRecord[]                  @relation("TallySyncRecordEnqueuedBy")
  performedTallySyncAttempts     TallySyncAttempt[]                 @relation("TallySyncAttemptPerformedBy")
  receivedNotifications          Notification[]                     @relation("NotificationRecipient")
  triggeredNotifications         Notification[]                     @relation("NotificationTriggeredBy")
  performedNotificationAttempts  NotificationAttempt[]              @relation("NotificationAttemptPerformedBy")
  returnRequests                 ReturnRequest[]                    @relation("ReturnRequestFarmerUser")
  returnRequestHistory           ReturnRequestStatusHistory[]       @relation("ReturnRequestStatusChangedBy")
  inspectedReturnRequests        ReturnRequest[]                    @relation("ReturnRequestInspectedBy")
  returnInspectionDispositions   ReturnInspectionDisposition[]      @relation("ReturnInspectionDispositionInspectedBy")
  uploadedReturnEvidence         ReturnRequestEvidence[]            @relation("ReturnRequestEvidenceUploadedBy")
  disputesAsFarmer               Dispute[]                          @relation("DisputeFarmerUser")
  raisedDisputes                 Dispute[]                          @relation("DisputeRaisedBy")
  assignedDisputes               Dispute[]                          @relation("DisputeAssignedTo")
  disputeEvents                  DisputeEvent[]                     @relation("DisputeEventActor")
  returnPickupAssignments        ReturnPickupAssignment[]           @relation("ReturnPickupPartner")
  returnPickupsAsFarmer          ReturnPickupAssignment[]           @relation("ReturnPickupFarmer")
  assignedReturnPickups          ReturnPickupAssignment[]           @relation("ReturnPickupAssignedBy")
  respondedReturnPickups         ReturnPickupAssignment[]           @relation("ReturnPickupRespondedBy")
  collectedReturnPickups         ReturnPickupAssignment[]           @relation("ReturnPickupCollectedBy")
  refundsAsFarmer                Refund[]                           @relation("RefundFarmerUser")
  initiatedRefunds               Refund[]                           @relation("RefundInitiatedBy")
  refundEvents                   RefundEvent[]                      @relation("RefundEventActor")
  recordedFarmActivities         FarmActivity[]                     @relation("FarmActivityRecordedBy")
  kisanClubPromoterProfile       KisanClubPromoterProfile?          @relation("ClubPromoterProfile")
  kisanClubAssignments           KisanClubPromoterAssignment[]      @relation("ClubAssignmentPromoter")
  assignedKisanClubAssignments   KisanClubPromoterAssignment[]      @relation("ClubAssignmentAssignedBy")
  createdKisanClubProgrammes     KisanClubProductProgramme[]        @relation("ClubProgrammeCreatedBy")
  createdKisanClubBenefitRules   KisanClubBenefitRule[]             @relation("ClubBenefitRuleCreatedBy")
  kisanClubFulfilmentAssignments KisanClubFulfilmentAssignment[]    @relation("ClubFulfilmentPromoter")
  kisanClubFulfilmentHistory     KisanClubFulfilmentStatusHistory[] @relation("ClubFulfilmentStatusChangedBy")
  storedFiles                    StoredFile[]                       @relation("StoredFileOwner")
  notificationPreferences        NotificationPreference[]           @relation("NotificationPreferenceUser")
  createdAt                      DateTime                           @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                           @updatedAt @db.Timestamptz(6)

  @@index([status])
}

enum OtpPurpose {
  LOGIN
  FARMER_REGISTRATION
}

model OtpChallenge {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone        String
  purpose      OtpPurpose @default(LOGIN)
  otpHash      String
  otpSalt      String
  expiresAt    DateTime   @db.Timestamptz(6)
  attemptCount Int        @default(0)
  consumedAt   DateTime?  @db.Timestamptz(6)
  requestedIp  String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  @@index([phone, purpose, consumedAt])
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId      String    @db.Uuid
  tokenHash         String    @unique
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId, revokedAt])
}

model UserProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  preferredLocale String   @default("en-IN")
  timezone        String   @default("Asia/Kolkata")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
}

model FarmerProfile {
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                     String                      @unique @db.Uuid
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                   String
  alternatePhone             String?
  preferredLocale            String                      @default("en-IN")
  village                    String?
  district                   String?
  state                      String?
  primaryPincode             String?
  cropInterests              String[]                    @default([])
  addresses                  FarmerAddress[]
  cart                       Cart?
  productCheckouts           ProductCheckout[]
  productOrders              ProductOrder[]
  productInvoices            ProductInvoice[]
  productDispatches          ProductDispatch[]
  productDeliveryAssignments ProductDeliveryAssignment[]
  paymentIntents             PaymentIntent[]
  promoterAttributions       PromoterAttribution[]
  convertedFarmerLeads       FarmerLead[]                @relation("FarmerLeadConvertedProfile")
  promoterVisits             PromoterVisit[]             @relation("PromoterVisitFarmer")
  returnRequests             ReturnRequest[]
  kisanClubMembership        KisanClubMembership?
  farms                      Farm[]
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(6)

  @@index([state, district])
  @@index([primaryPincode])
}

model KisanClubMembership {
  id                       String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmerProfileId          String                          @unique @db.Uuid
  farmerProfile            FarmerProfile                   @relation(fields: [farmerProfileId], references: [id], onDelete: Restrict)
  memberNumber             String                          @unique
  status                   KisanClubMembershipStatus       @default(PENDING_PROFILE)
  homePincode              String
  homeVillage              String?
  homeDistrict             String?
  homeState                String?
  joinedAt                 DateTime                        @db.Timestamptz(6)
  termsVersion             String
  termsAcceptedAt          DateTime                        @db.Timestamptz(6)
  advisoryConsent          Boolean                         @default(false)
  advisoryConsentAt        DateTime?                       @db.Timestamptz(6)
  marketingConsent         Boolean                         @default(false)
  marketingConsentAt       DateTime?                       @db.Timestamptz(6)
  preciseLocationConsent   Boolean                         @default(false)
  preciseLocationConsentAt DateTime?                       @db.Timestamptz(6)
  referredByMembershipId   String?                         @db.Uuid
  referredByMembership     KisanClubMembership?            @relation("ClubReferral", fields: [referredByMembershipId], references: [id], onDelete: SetNull)
  referrals                KisanClubMembership[]           @relation("ClubReferral")
  suspendedReason          String?
  closedAt                 DateTime?                       @db.Timestamptz(6)
  createdAt                DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                        @updatedAt @db.Timestamptz(6)
  farms                    Farm[]
  promoterAssignments      KisanClubPromoterAssignment[]
  benefitRedemptions       KisanClubBenefitRedemption[]
  benefitTokens            KisanClubBenefitToken[]
  fulfilmentAssignments    KisanClubFulfilmentAssignment[]
  advisoryEvents           AdvisoryEvent[]

  @@index([status, homePincode])
  @@index([homeDistrict, status])
}

model PromoterTerritory {
  id               String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  state            String
  district         String
  blocks           String[]                      @default([])
  pincodes         String[]                      @default([])
  villages         String[]                      @default([])
  status           PromoterTerritoryStatus       @default(ACTIVE)
  promoterProfiles KisanClubPromoterProfile[]
  assignments      KisanClubPromoterAssignment[]
  createdAt        DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                      @updatedAt @db.Timestamptz(6)

  @@index([state, district, status])
}

model KisanClubPromoterProfile {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoterUserId         String             @unique @db.Uuid
  promoterUser           User               @relation("ClubPromoterProfile", fields: [promoterUserId], references: [id], onDelete: Restrict)
  promoterOrganisationId String             @db.Uuid
  promoterOrganisation   Organisation       @relation("ClubPromoterOrganisation", fields: [promoterOrganisationId], references: [id], onDelete: Restrict)
  territoryId            String?            @db.Uuid
  territory              PromoterTerritory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  homeVillage            String?
  homePincode            String?
  clubEnabled            Boolean            @default(false)
  acceptingNewFarmers    Boolean            @default(true)
  maxActiveFarmers       Int                @default(150)
  activeFarmerCount      Int                @default(0)
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(6)

  @@index([territoryId, clubEnabled, acceptingNewFarmers])
  @@index([homePincode, clubEnabled])
}

model KisanClubPromoterAssignment {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId          String                    @db.Uuid
  membership            KisanClubMembership       @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  promoterUserId        String                    @db.Uuid
  promoterUser          User                      @relation("ClubAssignmentPromoter", fields: [promoterUserId], references: [id], onDelete: Restrict)
  territoryId           String?                   @db.Uuid
  territory             PromoterTerritory?        @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  status                KisanClubAssignmentStatus @default(ACTIVE)
  assignedAt            DateTime                  @default(now()) @db.Timestamptz(6)
  endedAt               DateTime?                 @db.Timestamptz(6)
  assignmentReason      KisanClubAssignmentReason
  matchScore            Json?
  assignedByUserId      String?                   @db.Uuid
  assignedBy            User?                     @relation("ClubAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  assignedByRole        PlatformRole?
  reason                String?
  promoterAttributionId String?                   @unique @db.Uuid
  promoterAttribution   PromoterAttribution?      @relation(fields: [promoterAttributionId], references: [id], onDelete: SetNull)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)

  @@index([membershipId, status])
  @@index([promoterUserId, status])
}

model KisanClubProductProgramme {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String                   @db.Uuid
  product           MasterProduct            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId         String?                  @db.Uuid
  variant           ProductVariant?          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  status            KisanClubProgrammeStatus @default(DRAFT)
  startsAt          DateTime                 @db.Timestamptz(6)
  endsAt            DateTime?                @db.Timestamptz(6)
  eligiblePincodes  String[]                 @default([])
  eligibleDistricts String[]                 @default([])
  displayPriority   Int                      @default(0)
  createdByUserId   String?                  @db.Uuid
  createdBy         User?                    @relation("ClubProgrammeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByRole     PlatformRole?
  reason            String?
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(6)
  benefitRules      KisanClubBenefitRule[]

  @@unique([productId, variantId])
  @@index([status, startsAt, endsAt])
  @@index([productId, status])
}

model KisanClubBenefitRule {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programmeId         String                       @db.Uuid
  programme           KisanClubProductProgramme    @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  benefitType         KisanClubBenefitType
  flatAmountPaise     Int?
  percentBps          Int?
  maxBenefitPaise     Int?
  minimumQuantity     Int                          @default(1)
  eligiblePincodes    String[]                     @default([])
  eligibleCropIds     String[]                     @default([]) @db.Uuid
  status              KisanClubBenefitStatus       @default(DRAFT)
  startsAt            DateTime                     @db.Timestamptz(6)
  endsAt              DateTime?                    @db.Timestamptz(6)
  totalUsageLimit     Int?
  perMemberUsageLimit Int?
  usageCount          Int                          @default(0)
  createdByUserId     String?                      @db.Uuid
  createdBy           User?                        @relation("ClubBenefitRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByRole       PlatformRole?
  reason              String?
  redemptions         KisanClubBenefitRedemption[]
  benefitTokens       KisanClubBenefitToken[]
  orderItems          ProductOrderItem[]
  createdAt           DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                     @updatedAt @db.Timestamptz(6)

  @@index([programmeId, status, startsAt, endsAt])
  @@index([status, startsAt, endsAt])
}

model KisanClubBenefitRedemption {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId              String                 @db.Uuid
  rule                KisanClubBenefitRule   @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  membershipId        String                 @db.Uuid
  membership          KisanClubMembership    @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  productOrderId      String                 @db.Uuid
  productOrder        ProductOrder           @relation(fields: [productOrderId], references: [id], onDelete: Restrict)
  productOrderItemId  String                 @unique @db.Uuid
  productOrderItem    ProductOrderItem       @relation(fields: [productOrderItemId], references: [id], onDelete: Restrict)
  quantity            Int
  perUnitBenefitPaise Int
  totalBenefitPaise   Int
  benefitTokenId      String?                @unique @db.Uuid
  benefitToken        KisanClubBenefitToken? @relation(fields: [benefitTokenId], references: [id], onDelete: Restrict)
  createdAt           DateTime               @default(now()) @db.Timestamptz(6)

  @@index([ruleId, createdAt])
  @@index([membershipId, ruleId])
  @@index([productOrderId])
}

model KisanClubBenefitToken {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenReference       String                      @unique
  membershipId         String                      @db.Uuid
  membership           KisanClubMembership         @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  benefitRuleId        String                      @db.Uuid
  benefitRule          KisanClubBenefitRule        @relation(fields: [benefitRuleId], references: [id], onDelete: Restrict)
  offerId              String                      @db.Uuid
  offer                DistributorOffer            @relation(fields: [offerId], references: [id], onDelete: Restrict)
  promoterUserId       String?                     @db.Uuid
  quantity             Int
  quotedUnitPricePaise Int
  quotedBenefitPaise   Int
  tokenHash            String                      @unique
  tokenSalt            String
  status               KisanClubBenefitTokenStatus @default(ISSUED)
  expiresAt            DateTime                    @db.Timestamptz(6)
  attemptCount         Int                         @default(0)
  consumedAt           DateTime?                   @db.Timestamptz(6)
  consumedByUserId     String?                     @db.Uuid
  productOrderId       String?                     @unique @db.Uuid
  productOrder         ProductOrder?               @relation(fields: [productOrderId], references: [id], onDelete: Restrict)
  redemption           KisanClubBenefitRedemption?
  createdAt            DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(6)

  @@index([membershipId, status])
  @@index([status, expiresAt])
  @@index([promoterUserId, status])
}

model KisanClubFulfilmentAssignment {
  id             String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productOrderId String                             @unique @db.Uuid
  productOrder   ProductOrder                       @relation(fields: [productOrderId], references: [id], onDelete: Restrict)
  membershipId   String                             @db.Uuid
  membership     KisanClubMembership                @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  promoterUserId String                             @db.Uuid
  promoterUser   User                               @relation("ClubFulfilmentPromoter", fields: [promoterUserId], references: [id], onDelete: Restrict)
  mode           KisanClubFulfilmentMode
  status         KisanClubFulfilmentStatus          @default(ASSIGNED)
  assignedAt     DateTime                           @default(now()) @db.Timestamptz(6)
  acceptedAt     DateTime?                          @db.Timestamptz(6)
  completedAt    DateTime?                          @db.Timestamptz(6)
  failureReason  String?
  statusHistory  KisanClubFulfilmentStatusHistory[]
  createdAt      DateTime                           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                           @updatedAt @db.Timestamptz(6)

  @@index([promoterUserId, status])
  @@index([membershipId, status])
  @@index([status, assignedAt])
}

model KisanClubFulfilmentStatusHistory {
  id              String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId    String                        @db.Uuid
  assignment      KisanClubFulfilmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fromStatus      KisanClubFulfilmentStatus?
  toStatus        KisanClubFulfilmentStatus
  changedByUserId String?                       @db.Uuid
  changedBy       User?                         @relation("ClubFulfilmentStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByRole   PlatformRole?
  reason          String?
  requestId       String?
  createdAt       DateTime                      @default(now()) @db.Timestamptz(6)

  @@index([assignmentId, createdAt])
  @@index([changedByUserId, createdAt])
}

model Crop {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String          @unique
  nameEn     String
  nameHi     String
  isActive   Boolean         @default(true)
  cropCycles FarmCropCycle[]
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(6)

  @@index([isActive, nameEn])
}

model Farm {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId       String?              @db.Uuid
  membership         KisanClubMembership? @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  farmerProfileId    String               @db.Uuid
  farmerProfile      FarmerProfile        @relation(fields: [farmerProfileId], references: [id], onDelete: Restrict)
  name               String
  village            String?
  district           String?
  state              String?
  pincode            String
  areaAcres          Decimal              @db.Decimal(10, 3)
  ownershipType      FarmOwnershipType
  irrigationSource   IrrigationSource?
  soilType           String?
  latitude           Decimal?             @db.Decimal(9, 6)
  longitude          Decimal?             @db.Decimal(9, 6)
  locationCapturedAt DateTime?            @db.Timestamptz(6)
  isActive           Boolean              @default(true)
  cropCycles         FarmCropCycle[]
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)

  @@index([membershipId, isActive])
  @@index([farmerProfileId, isActive])
  @@index([pincode])
  @@index([district, state])
}

model FarmCropCycle {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmId              String          @db.Uuid
  farm                Farm            @relation(fields: [farmId], references: [id], onDelete: Restrict)
  cropId              String          @db.Uuid
  crop                Crop            @relation(fields: [cropId], references: [id], onDelete: Restrict)
  varietyName         String?
  varietyProductId    String?         @db.Uuid
  varietyProduct      MasterProduct?  @relation(fields: [varietyProductId], references: [id], onDelete: SetNull)
  areaAcres           Decimal         @db.Decimal(10, 3)
  season              String
  sowingDate          DateTime?       @db.Date
  expectedHarvestDate DateTime?       @db.Date
  actualHarvestDate   DateTime?       @db.Date
  status              CropCycleStatus @default(ACTIVE)
  yieldQuintals       Decimal?        @db.Decimal(10, 3)
  activities          FarmActivity[]
  advisoryEvents      AdvisoryEvent[]
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)

  @@index([farmId, status])
  @@index([cropId, season, status])
  @@index([status, sowingDate])
}

model AdvisoryRule {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cropName           String
  varietyName        String?
  category           AdvisoryCategory
  minDaysAfterSowing Int
  maxDaysAfterSowing Int
  eligibleStates     String[]           @default([])
  eligibleDistricts  String[]           @default([])
  seasons            String[]           @default([])
  titleEn            String
  bodyEn             String
  titleHi            String
  bodyHi             String
  status             AdvisoryRuleStatus @default(DRAFT)
  version            Int                @default(1)
  authoredByUserId   String?            @db.Uuid
  reviewedByUserId   String?            @db.Uuid
  reviewedAt         DateTime?          @db.Timestamptz(6)
  reviewReason       String?
  sourceReference    String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  events             AdvisoryEvent[]

  @@index([cropName, status, minDaysAfterSowing])
  @@index([status, category])
}

model AdvisoryEvent {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cropCycleId    String              @db.Uuid
  cropCycle      FarmCropCycle       @relation(fields: [cropCycleId], references: [id], onDelete: Restrict)
  membershipId   String              @db.Uuid
  membership     KisanClubMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  advisoryRuleId String              @db.Uuid
  advisoryRule   AdvisoryRule        @relation(fields: [advisoryRuleId], references: [id], onDelete: Restrict)
  ruleVersion    Int
  status         AdvisoryEventStatus @default(PENDING)
  dueOn          DateTime            @db.Date
  notificationId String?             @db.Uuid
  readAt         DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)

  @@unique([cropCycleId, advisoryRuleId, ruleVersion])
  @@index([membershipId, status, dueOn])
}

model FarmActivity {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cropCycleId      String             @db.Uuid
  cropCycle        FarmCropCycle      @relation(fields: [cropCycleId], references: [id], onDelete: Restrict)
  activityType     FarmActivityType
  occurredOn       DateTime           @db.Date
  notes            String?
  productOrderId   String?            @db.Uuid
  productOrder     ProductOrder?      @relation(fields: [productOrderId], references: [id], onDelete: SetNull)
  recordedSource   FarmActivitySource
  recordedByUserId String?            @db.Uuid
  recordedBy       User?              @relation("FarmActivityRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)

  @@index([cropCycleId, occurredOn])
  @@index([activityType, occurredOn])
  @@index([productOrderId])
}

model FarmerAddress {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmerProfileId        String            @db.Uuid
  farmerProfile          FarmerProfile     @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  label                  String
  recipientName          String
  phone                  String
  addressLine1           String
  addressLine2           String?
  village                String?
  city                   String
  district               String?
  state                  String
  stateCode              String?
  pincode                String
  landmark               String?
  isDefault              Boolean           @default(false)
  deliveryCarts          Cart[]            @relation("CartDeliveryAddress")
  checkoutDeliveries     ProductCheckout[] @relation("CheckoutDeliveryAddress")
  productOrderDeliveries ProductOrder[]    @relation("ProductOrderDeliveryAddress")
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)

  @@index([farmerProfileId, isDefault])
  @@index([pincode])
}

model Organisation {
  id                               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                             OrganisationType
  slug                             String                      @unique
  legalName                        String
  displayName                      String
  gstin                            String?
  registeredStateCode              String?
  gstinVerifiedAt                  DateTime?                   @db.Timestamptz(6)
  status                           OrganisationStatus          @default(PENDING_VERIFICATION)
  returnRequests                   ReturnRequest[]             @relation("ReturnRequestDistributor")
  sellerDisputes                   Dispute[]                   @relation("DisputeDistributorOrganisation")
  disputesAgainstOrganisation      Dispute[]                   @relation("DisputeAgainstOrganisation")
  returnPickupAssignments          ReturnPickupAssignment[]    @relation("ReturnPickupDistributor")
  reviewedAt                       DateTime?                   @db.Timestamptz(6)
  reviewedByUserId                 String?                     @db.Uuid
  reviewedBy                       User?                       @relation("OrganisationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewReason                     String?
  memberships                      OrganisationMembership[]
  companyProfile                   CompanyProfile?
  distributorProfile               DistributorProfile?
  kycDocuments                     KycDocument[]
  brands                           Brand[]                     @relation("CompanyBrands")
  masterProducts                   MasterProduct[]             @relation("CompanyProducts")
  warehouses                       Warehouse[]                 @relation("DistributorWarehouses")
  inventoryBatches                 InventoryBatch[]            @relation("DistributorBatches")
  inventoryMovements               InventoryMovement[]         @relation("DistributorInventoryMovements")
  distributorOffers                DistributorOffer[]          @relation("DistributorOffers")
  cartItems                        CartItem[]
  sellerProductOrders              ProductOrder[]              @relation("SellerProductOrders")
  sellerProductInvoices            ProductInvoice[]            @relation("SellerProductInvoices")
  invoiceSequences                 InvoiceSequence[]
  creditNoteSequences              CreditNoteSequence[]
  creditNotes                      CreditNote[]
  sellerProductDispatches          ProductDispatch[]           @relation("SellerProductDispatches")
  sellerProductDeliveryAssignments ProductDeliveryAssignment[] @relation("SellerProductDeliveryAssignments")
  deliveryPartnerProfiles          DeliveryPartnerProfile[]    @relation("DeliveryPartnerProfileOrganisation")
  farmerLeads                      FarmerLead[]                @relation("FarmerLeadOrganisation")
  promoterVisits                   PromoterVisit[]             @relation("PromoterVisitOrganisation")
  auditLogs                        AuditLog[]
  sellerCommissionRules            CommissionRule[]            @relation("SellerCommissionRules")
  sellerCommissionEntries          CommissionEntry[]           @relation("SellerCommissionEntries")
  financialLedgerEntries           FinancialLedgerEntry[]      @relation("OrganisationFinancialLedgerEntries")
  sellerSettlements                Settlement[]                @relation("SellerSettlements")
  promoterAttributions             PromoterAttribution[]       @relation("PromoterAttributionOrganisation")
  kisanClubPromoterProfiles        KisanClubPromoterProfile[]  @relation("ClubPromoterOrganisation")
  supportTickets                   SupportTicket[]
  storedFiles                      StoredFile[]                @relation("StoredFileOrganisation")
  createdAt                        DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                        DateTime                    @updatedAt @db.Timestamptz(6)
  productOrderItems                ProductOrderItem[]

  @@index([type, status])
  @@index([reviewedByUserId, reviewedAt])
}

model DeliveryPartnerProfile {
  id                    String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String                            @db.Uuid
  user                  User                              @relation("DeliveryPartnerProfileUser", fields: [userId], references: [id], onDelete: Restrict)
  organisationId        String                            @db.Uuid
  organisation          Organisation                      @relation("DeliveryPartnerProfileOrganisation", fields: [organisationId], references: [id], onDelete: Restrict)
  availabilityStatus    DeliveryPartnerAvailabilityStatus @default(OFFLINE)
  availabilityChangedAt DateTime?                         @db.Timestamptz(6)
  createdAt             DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                          @updatedAt @db.Timestamptz(6)

  @@unique([userId, organisationId])
  @@index([organisationId, availabilityStatus])
}

model FarmerLead {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoterUserId           String           @db.Uuid
  promoterUser             User             @relation("FarmerLeadPromoter", fields: [promoterUserId], references: [id], onDelete: Restrict)
  promoterOrganisationId   String           @db.Uuid
  promoterOrganisation     Organisation     @relation("FarmerLeadOrganisation", fields: [promoterOrganisationId], references: [id], onDelete: Restrict)
  fullName                 String
  phone                    String
  source                   FarmerLeadSource
  status                   FarmerLeadStatus @default(NEW)
  village                  String?
  district                 String?
  state                    String?
  pincode                  String?
  cropInterests            String[]         @default([])
  notes                    String?
  statusReason             String?
  contactedAt              DateTime?        @db.Timestamptz(6)
  convertedAt              DateTime?        @db.Timestamptz(6)
  lostAt                   DateTime?        @db.Timestamptz(6)
  convertedFarmerProfileId String?          @db.Uuid
  convertedFarmerProfile   FarmerProfile?   @relation("FarmerLeadConvertedProfile", fields: [convertedFarmerProfileId], references: [id], onDelete: Restrict)
  promoterVisits           PromoterVisit[]
  createdAt                DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(6)

  @@index([promoterUserId, status, updatedAt])
  @@index([promoterOrganisationId, status, updatedAt])
  @@index([phone])
  @@index([convertedFarmerProfileId])
}

model PromoterVisit {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoterUserId         String                      @db.Uuid
  promoterUser           User                        @relation("PromoterVisitPromoter", fields: [promoterUserId], references: [id], onDelete: Restrict)
  promoterOrganisationId String                      @db.Uuid
  promoterOrganisation   Organisation                @relation("PromoterVisitOrganisation", fields: [promoterOrganisationId], references: [id], onDelete: Restrict)
  farmerLeadId           String?                     @db.Uuid
  farmerLead             FarmerLead?                 @relation(fields: [farmerLeadId], references: [id], onDelete: Restrict)
  farmerProfileId        String?                     @db.Uuid
  farmerProfile          FarmerProfile?              @relation("PromoterVisitFarmer", fields: [farmerProfileId], references: [id], onDelete: Restrict)
  purpose                PromoterVisitPurpose
  notes                  String?
  occurredAt             DateTime                    @db.Timestamptz(6)
  locationStatus         PromoterVisitLocationStatus @default(NOT_REQUESTED)
  latitude               Decimal?                    @db.Decimal(9, 6)
  longitude              Decimal?                    @db.Decimal(9, 6)
  accuracyMetres         Decimal?                    @db.Decimal(8, 2)
  locationCapturedAt     DateTime?                   @db.Timestamptz(6)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(6)

  @@index([promoterUserId, occurredAt])
  @@index([promoterOrganisationId, occurredAt])
  @@index([farmerLeadId, occurredAt])
  @@index([farmerProfileId, occurredAt])
}

model CompanyProfile {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String       @unique @db.Uuid
  organisation        Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  brandName           String?
  registrationNumber  String?
  pan                 String?
  primaryContactName  String
  primaryContactPhone String
  primaryContactEmail String?
  website             String?
  registeredAddress   String?
  city                String?
  state               String?
  pincode             String?
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)

  @@index([brandName])
  @@index([state, city])
}

model DistributorProfile {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId       String       @unique @db.Uuid
  organisation         Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  distributorCode      String?      @unique
  pan                  String?
  primaryContactName   String
  primaryContactPhone  String
  primaryContactEmail  String?
  operatingAddress     String?
  city                 String?
  state                String?
  pincode              String?
  serviceablePincodes  String[]     @default([])
  fulfilmentCapability String?
  createdAt            DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(6)

  @@index([state, city])
}

model KycDocument {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String            @db.Uuid
  organisation    Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  documentType    KycDocumentType
  status          KycDocumentStatus @default(SUBMITTED)
  documentNumber  String?
  fileName        String?
  /// Legacy free-text key from the metadata-only era. New uploads populate
  /// `storedFileId` instead; this stays for rows created before WP-08.
  storageKey      String?
  storedFileId    String?           @db.Uuid
  storedFile      StoredFile?       @relation("KycDocumentStoredFile", fields: [storedFileId], references: [id], onDelete: Restrict)
  issuedAt        DateTime?         @db.Timestamptz(6)
  expiresAt       DateTime?         @db.Timestamptz(6)
  rejectionReason String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  @@index([organisationId, status])
  @@index([documentType, status])
}

model Brand {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyOrganisationId String          @db.Uuid
  companyOrganisation   Organisation    @relation("CompanyBrands", fields: [companyOrganisationId], references: [id], onDelete: Restrict)
  name                  String
  slug                  String
  description           String?
  website               String?
  status                CatalogueStatus @default(DRAFT)
  reviewedAt            DateTime?       @db.Timestamptz(6)
  reviewedByUserId      String?         @db.Uuid
  reviewedBy            User?           @relation("BrandReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewReason          String?
  products              MasterProduct[]
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(6)

  @@unique([companyOrganisationId, slug])
  @@index([companyOrganisationId, status])
  @@index([status, createdAt])
}

model MasterProduct {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyOrganisationId    String                      @db.Uuid
  companyOrganisation      Organisation                @relation("CompanyProducts", fields: [companyOrganisationId], references: [id], onDelete: Restrict)
  brandId                  String                      @db.Uuid
  brand                    Brand                       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name                     String
  slug                     String
  category                 String
  description              String?
  cropTargets              String[]                    @default([])
  /// Pack shot shown to farmers. Nullable because a product can be approved and
  /// sellable before its photography exists; the apps fall back to a labelled
  /// placeholder rather than a broken image.
  primaryImageStoredFileId String?                     @db.Uuid
  primaryImage             StoredFile?                 @relation("ProductPrimaryImage", fields: [primaryImageStoredFileId], references: [id], onDelete: SetNull)
  status                   CatalogueStatus             @default(DRAFT)
  reviewedAt               DateTime?                   @db.Timestamptz(6)
  reviewedByUserId         String?                     @db.Uuid
  reviewedBy               User?                       @relation("ProductReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewReason             String?
  variants                 ProductVariant[]
  documents                ProductDocument[]
  inventoryBatches         InventoryBatch[]
  inventoryMovements       InventoryMovement[]
  distributorOffers        DistributorOffer[]
  cartItems                CartItem[]
  productOrderItems        ProductOrderItem[]
  farmCropCycles           FarmCropCycle[]
  kisanClubProgrammes      KisanClubProductProgramme[]
  createdAt                DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                    @updatedAt @db.Timestamptz(6)

  @@unique([companyOrganisationId, slug])
  @@index([brandId, status])
  @@index([companyOrganisationId, status])
  @@index([status, createdAt])
}

model ProductVariant {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId           String                      @db.Uuid
  product             MasterProduct               @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku                 String?
  variantName         String
  packSize            Decimal                     @db.Decimal(12, 3)
  packUnit            String
  mrpPaise            Int?
  hsnCode             String?
  gstRateBps          Int?
