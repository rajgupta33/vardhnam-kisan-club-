{
  "name": "@vardhnam/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "openapi-typescript ../../apps/marketplace-api/openapi.json -o src/generated/openapi.ts --alphabetize",
    "check:generated": "npm run generate -- --check",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test src/**/*.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "eslint": "^9.11.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.7.0"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
